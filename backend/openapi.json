{
  "openapi": "3.0.3",
  "info": {
    "title": "MERN Support Tickets API",
    "version": "1.0.0",
    "description": "Synthetic portfolio demo. Customers see and comment on their own tickets; agents see all tickets and can change status. Both roles can create tickets owned by themselves. No registration or public role assignment. Access tokens expire after one hour."
  },
  "servers": [
    { "url": "http://127.0.0.1:4000/api", "description": "Local API" }
  ],
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Database readiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Connected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "database"],
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] },
                    "database": { "type": "string", "enum": ["connected"] }
                  }
                }
              }
            }
          },
          "503": { "$ref": "#/components/responses/NotReady" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openApi",
        "summary": "This OpenAPI document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.0.3 JSON document",
            "content": {
              "application/json": { "schema": { "type": "object" } }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Sign in",
        "security": [],
        "description": "20 requests per IP per five-minute window. Invalid email/password combinations return the same message. Password input is limited to 72 UTF-8 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72,
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["token", "expiresIn", "user"],
                  "properties": {
                    "token": { "type": "string" },
                    "expiresIn": { "type": "integer", "example": 3600 },
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "413": { "$ref": "#/components/responses/TooLarge" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me",
        "summary": "Current account and current database role",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["user"],
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/tickets": {
      "get": {
        "operationId": "listTickets",
        "summary": "List accessible tickets, newest first",
        "description": "Customers are always scoped to themselves. Filters are combined with AND; q is a case-insensitive literal substring of title or description. Pagination ties are broken by descending ID. Arbitrary filter/sort fields are rejected.",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" },
          {
            "in": "query",
            "name": "status",
            "schema": { "$ref": "#/components/schemas/Status" }
          },
          {
            "in": "query",
            "name": "priority",
            "schema": { "$ref": "#/components/schemas/Priority" }
          },
          {
            "in": "query",
            "name": "q",
            "schema": { "type": "string", "maxLength": 100 },
            "description": "Literal text, not a regular expression"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of tickets",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Pagination" },
                    {
                      "type": "object",
                      "required": ["items"],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Ticket" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createTicket",
        "summary": "Create an open ticket owned by the signed-in user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewTicket" }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/TicketResult" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "$ref": "#/components/responses/TooLarge" }
        }
      }
    },
    "/tickets/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/TicketId" }],
      "get": {
        "operationId": "getTicket",
        "summary": "Read an accessible ticket",
        "description": "Other customers' tickets and nonexistent tickets both return 404.",
        "responses": {
          "200": { "$ref": "#/components/responses/TicketResult" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/tickets/{id}/status": {
      "parameters": [{ "$ref": "#/components/parameters/TicketId" }],
      "patch": {
        "operationId": "changeStatus",
        "summary": "Agent-only status update",
        "description": "An agent can move between any of the three statuses, including reopening a done ticket. No assignment workflow or optimistic concurrency is implemented.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status"],
                "properties": {
                  "status": { "$ref": "#/components/schemas/Status" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/TicketResult" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/TooLarge" }
        }
      }
    },
    "/tickets/{id}/comments": {
      "parameters": [{ "$ref": "#/components/parameters/TicketId" }],
      "get": {
        "operationId": "listComments",
        "summary": "Read comments on an accessible ticket, newest first",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/Limit" }
        ],
        "responses": {
          "200": {
            "description": "Page of comments",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/Pagination" },
                    {
                      "type": "object",
                      "required": ["items"],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Comment" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "operationId": "addComment",
        "summary": "Add a comment as the signed-in user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["body"],
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created comment",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["comment"],
                  "properties": {
                    "comment": { "$ref": "#/components/schemas/Comment" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "413": { "$ref": "#/components/responses/TooLarge" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "TicketId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^[a-fA-F0-9]{24}$" }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 1
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 10
        }
      }
    },
    "schemas": {
      "Status": { "type": "string", "enum": ["open", "in progress", "done"] },
      "Priority": { "type": "string", "enum": ["low", "normal", "high"] },
      "User": {
        "type": "object",
        "required": ["id", "name", "email", "role"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["customer", "agent"] }
        }
      },
      "NewTicket": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string", "minLength": 3, "maxLength": 120 },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 5000
          },
          "priority": {
            "allOf": [{ "$ref": "#/components/schemas/Priority" }],
            "default": "normal"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "status",
          "priority",
          "owner",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": { "$ref": "#/components/schemas/Status" },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "owner": {
            "allOf": [{ "$ref": "#/components/schemas/User" }],
            "nullable": true
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Comment": {
        "type": "object",
        "required": ["id", "body", "author", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "body": { "type": "string" },
          "author": {
            "allOf": [{ "$ref": "#/components/schemas/User" }],
            "nullable": true
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Pagination": {
        "type": "object",
        "required": ["total", "page", "limit", "totalPages"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "page": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1 },
          "totalPages": { "type": "integer", "minimum": 0 }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["field", "message"],
                  "properties": {
                    "field": { "type": "string" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "TicketResult": {
        "description": "Ticket",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["ticket"],
              "properties": {
                "ticket": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid fields, query, ticket ID or JSON; validation errors include details",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid or expired token, unavailable user, or invalid credentials",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Forbidden": {
        "description": "Agent role required",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Missing ticket or ticket not accessible to this customer",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "RateLimited": {
        "description": "Too many login attempts; retry after the rate-limit window",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "TooLarge": {
        "description": "JSON request body exceeds 32 KB",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotReady": {
        "description": "MongoDB connection is not ready",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}
